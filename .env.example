# ───────────────────────── Core ─────────────────────────
# Postgres (Supabase or Neon, Singapore region). Use the pooled URL for DATABASE_URL and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/postgres"
# 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="https://argon.com.bd"
# Vercel Cron sends this as a Bearer token
CRON_SECRET=""

# Owner account created by `npm run db:seed` on first run (2FA setup is forced at first login)
OWNER_EMAIL="owner@argon.com.bd"
OWNER_PASSWORD=""

# ───────────────────────── Media ─────────────────────────
# Vercel Blob (recommended on Vercel). Without it, uploads go to ./public/uploads in development.
BLOB_READ_WRITE_TOKEN=""

# ───────────────────────── Payments ─────────────────────────
# bKash Tokenized Checkout. Sandbox credentials: https://developer.bka.sh (Sandbox → Tokenized → test credentials)
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
# Nagad. Keys are base64 PEM bodies (with or without the BEGIN/END lines).
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
# SSLCommerz. Free sandbox store: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
# Sandbox/live is toggled per gateway in Admin → Payments.

# ───────────────────────── Couriers ─────────────────────────
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
PATHAO_SANDBOX="true"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""
REDX_SANDBOX="true"
REDX_API_TOKEN=""
REDX_DEFAULT_AREA_ID=""

# ───────────────────────── Messaging ─────────────────────────
# console | bulksmsbd | sslwireless | alphasms
SMS_PROVIDER="console"
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID=""
SSL_SMS_API_TOKEN=""
SSL_SMS_SID=""
ALPHA_SMS_API_KEY=""
ALPHA_SMS_SENDER_ID=""
RESEND_API_KEY=""
EMAIL_FROM="ARGON <orders@argon.com.bd>"
TELEGRAM_BOT_TOKEN=""

# ───────────────────────── Marketing ─────────────────────────
# Pixel IDs are set in Admin → Marketing. The CAPI token stays server-side.
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""
